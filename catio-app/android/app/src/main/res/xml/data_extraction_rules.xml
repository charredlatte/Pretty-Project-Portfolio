<?xml version="1.0" encoding="utf-8"?>
<!-- The sign-in cookie and the fetched pack art never leave the device: no cloud backup, no
     device-to-device transfer. The art's licences forbid redistributing it, and the cookie authorises
     every write the owner can make. -->
<data-extraction-rules>
    <cloud-backup><exclude domain="root" /><exclude domain="file" /><exclude domain="sharedpref" /></cloud-backup>
    <device-transfer><exclude domain="root" /><exclude domain="file" /><exclude domain="sharedpref" /></device-transfer>
</data-extraction-rules>
